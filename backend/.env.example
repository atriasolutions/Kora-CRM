PORT=4000
NODE_ENV=development

DATABASE_URL=postgresql://localhost:5432/zenter_crm

# Usuario demo para auditoría (UUID del seed — maria.lopez@kora.io)
DEMO_USER_ID=b1000001-0001-4001-8001-000000000001
DEMO_USER_NAME=María López

# Orígenes permitidos (frontend Vite)
CORS_ORIGIN=http://localhost:5173

# URL pública del frontend (enlaces en correos)
APP_PUBLIC_URL=http://localhost:5173

# Correo (Mailtrap Sending API — recomendado en pruebas reales)
MAIL_ENABLED=true
MAILTRAP_TOKEN=
# Debe estar autorizado en Mailtrap → Sending → Domains (dominio atriasolutions.cl)
MAIL_FROM_ADDRESS=noreply@atriasolutions.cl
MAIL_FROM_NAME=Kora CRM

# Alternativa: Sandbox SMTP (Email Testing → SMTP)
# MAIL_SMTP_HOST=sandbox.smtp.mailtrap.io
# MAIL_SMTP_PORT=2525
# MAIL_SMTP_USER=
# MAIL_SMTP_PASS=

# Opcional: redirige todos los envíos a un solo inbox (pruebas)
# MAIL_OVERRIDE_TO=tu-correo@gmail.com

# Solicitudes «Prueba gratis» desde koracrm.cl (landing pública)
# MARKETING_LEAD_TO=ventas@tuempresa.cl
# MARKETING_AUTO_PROVISION_TRIAL=true
# MARKETING_TRIAL_DAYS=14
# APP_PUBLIC_URL=https://koracrm.cl

# Facturación electrónica SII (por tenant; certificados cifrados en DB)
# SII_CREDENTIALS_ENCRYPTION_KEY=...  # mín. 32 chars en producción
# SII_ENV=certification
